{
  "name": "kyoto-vibe-git-template",
  "repository": "stevepeak/kyoto-template",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Template",
  "workspaces": {
    "packages": [
      "apps/*",
      "config/*",
      "packages/*"
    ],
    "catalog": {
      "@openrouter/ai-sdk-provider": "^3.1.0",
      "@tanstack/react-query": "^5.107.1",
      "@trpc/client": "^11.28.2",
      "@trpc/react-query": "^11.28.2",
      "@trpc/server": "^11.28.2",
      "@types/node": "^26.6.6",
      "ai": "^7.0.173",
      "drizzle-orm": "^0.45.4",
      "eslint": "^10.15.0",
      "posthog-js": "^1.449.2",
      "posthog-node": "^5.73.1",
      "typescript": "npm:@typescript/typescript6@^6.0.2",
      "zod": "^4.6.7",
      "@cloudflare/workers-types": "^5.20261114.1",
      "@types/bun": "^1.4.4",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "wrangler": "^4.162.0"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@app/web",
    "build": "turbo run build",
    "preview": "turbo run preview",
    "prepare": "husky || true",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "ci": "bun run typecheck && bun run lint && bun run knip && bun run build",
    "fix": "turbo run fix",
    "clean": "turbo run clean | rm -rf .turbo",
    "kill": "&& lsof -i :3000 -t | xargs -r kill && lsof -i :3001 -t | xargs -r kill && lsof -i :6006 -t | xargs -r kill",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:migrate:local": "bun run --cwd packages/db db:migrate:local"
  },
  "devDependencies": {
    "eslint": "^10.4.0",
    "knip": "^6.14.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json,md,mdx}": [
      "prettier --write"
    ]
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": "1"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "esbuild",
    "sharp",
    "workerd"
  ]
}
