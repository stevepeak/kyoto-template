{
  // Not a deployable Worker — exists so `wrangler d1 migrations apply` can run
  // from this package (`db:migrate`, `db:migrate:local`). The web and
  // workflows Workers bind the same database as `DB` in their own configs.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "template-db-migrations",
  // TODO: set your Cloudflare account id (or rely on CLOUDFLARE_ACCOUNT_ID).
  "d1_databases": [
    {
      "binding": "DB",
      // TODO: choose the database name, create it with
      // `bunx wrangler d1 create <name>` (pick a location/jurisdiction), and
      // paste the returned id below and into apps/web + apps/workflows.
      "database_name": "template-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations",
    },
  ],
  "env": {
    // PR preview deploys' database — see apps/web/wrangler.jsonc `env.staging`.
    "staging": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "template-db-staging",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "./migrations",
        },
      ],
    },
  },
}
