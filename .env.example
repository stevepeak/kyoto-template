# ── App ──────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# ── Google sign-in (optional — the button hides when unset) ──────────────────
# TODO: create an OAuth client; redirect URI: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Cloudflare Turnstile (optional — bot check on sign-up/sign-in/reset) ─────
# TODO: create a widget in the Cloudflare dashboard. For local testing use
# Cloudflare's always-pass test keys:
#   site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Email (Cloudflare Email Sending; dev logs instead of sending) ─────────────
# TODO: sender must be in send_email.allowed_sender_addresses (wrangler.jsonc)
EMAIL_FROM=""
EMAIL_FROM_NAME=""

# ── Cloudflare (CLI/CI only — D1 migrations, drizzle studio, deploys) ────────
CLOUDFLARE_ACCOUNT_ID=""
# Token with D1:Edit + Workers Scripts:Edit
CLOUDFLARE_API_TOKEN=""
# id of the app D1 (template-db) — for `db:studio` against remote
D1_DATABASE_ID=""

# ── Cloudflare Workflows worker ──────────────────────────────────────────────
# Generate TOKEN_SIGNING_KEY with: openssl rand -base64 32
TOKEN_SIGNING_KEY=""
WORKFLOWS_URL="http://localhost:8787"
NEXT_PUBLIC_WORKFLOWS_URL="http://localhost:8787"
# Dev only — bearer for the HTTP fallback `next dev` uses when the WORKFLOWS
# service binding isn't wired. Both Workers read this file (via .dev.vars), so
# one value covers both. Leave unset in production: the routes then fail closed.
WORKFLOWS_SHARED_SECRET=""

# ── 007 workflow console access ──────────────────────────────────────────────
# Comma-separated emails allowed into /workflows and /admin. Unset: any
# signed-in user under `next dev`, nobody in production.
WF_ADMIN_EMAILS=""

# ── AI — routed through OpenRouter ───────────────────────────────────────────
OPENROUTER_API_KEY=""

# ── 007 (optional) — seals MCP-connector tokens; same value on both Workers ──
WF_CONNECTOR_KEY=""

# ── PostHog (optional) ───────────────────────────────────────────────────────
POSTHOG_API_KEY=""
POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_POSTHOG_API_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ── Sentry (optional — off when unset, and always off in `next dev`) ─────────
# Server/Worker DSN (`wrangler secret put SENTRY_DSN` on both Workers) and the
# browser DSN, inlined at build time (usually the same value).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Build-time source-map upload — CI only (GitHub secret + variables).
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
