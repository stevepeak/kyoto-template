DATABASE_URL="postgres://postgres@localhost:5432/kyoto"
BETTER_AUTH_SECRET=random-string

# AI — routed through OpenRouter
OPENROUTER_API_KEY="sk-or-v1-xxxxx"

# Cloudflare Workflows worker
# Generate TOKEN_SIGNING_KEY with: openssl rand -base64 32
TOKEN_SIGNING_KEY="change-me-to-a-32-byte-random-string"
WORKFLOWS_URL="http://localhost:8787"
NEXT_PUBLIC_WORKFLOWS_URL="http://localhost:8787"

# PostHog (server)
POSTHOG_API_KEY="phc_xxxxx"
POSTHOG_HOST="https://us.i.posthog.com"

# PostHog (browser — inlined into the client bundle at build time)
NEXT_PUBLIC_POSTHOG_API_KEY="phc_xxxxx"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
