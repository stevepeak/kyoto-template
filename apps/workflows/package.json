{
  "name": "@app/workflows",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Workflows / Queues / Durable Objects worker \u2014 replaces Trigger.dev",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "clean": "rm -rf node_modules dist .wrangler",
    "predev": "test -e .dev.vars || ln -sf ../../.env .dev.vars",
    "dev": "wrangler dev --port 8787 --persist-to ../../.wrangler/state",
    "predev:scheduled": "test -e .dev.vars || ln -sf ../../.env .dev.vars",
    "dev:scheduled": "wrangler dev --port 8787 --persist-to ../../.wrangler/state --test-scheduled",
    "deploy": "wrangler deploy --var \"WF_SDK_RELEASE:$(git rev-parse HEAD:packages/007)\"",
    "deploy:staging": "wrangler deploy --env staging --keep-vars --var \"WF_SDK_RELEASE:$(git rev-parse HEAD:packages/007)\"",
    "tail": "wrangler tail",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv worker-env.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --ignore-path='../../.prettierignore' --check .",
    "fix": "eslint --fix --quiet . && prettier --ignore-path='../../.prettierignore' --log-level=silent --write .",
    "db:migrate:wf:local": "wrangler d1 migrations apply template-wf --local --persist-to ../../.wrangler/state",
    "db:migrate:wf": "wrangler d1 migrations apply template-wf --remote",
    "db:migrate:wf:staging": "wrangler d1 migrations apply template-wf-staging --remote --env staging"
  },
  "dependencies": {
    "@app/agents": "workspace:*",
    "@app/wf-host": "workspace:*",
    "@app/workflows-client": "workspace:*",
    "@openrouter/ai-sdk-provider": "catalog:",
    "@sentry/cloudflare": "^11.12.0",
    "@stevepeak/007": "workspace:*",
    "ai": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@app/eslint-config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "tsconfig": "workspace:*",
    "typescript": "catalog:",
    "wrangler": "^4.162.0"
  }
}
