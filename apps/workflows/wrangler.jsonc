{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "template-workflows",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
  },
  // The deployed version's id — Sentry tags events with it as the release.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  // Workflows — one binding per WorkflowEntrypoint class.
  // Add a new entry whenever you add a workflow in src/workflows/.
  "workflows": [
    {
      "name": "hello-world",
      "binding": "HELLO_WORLD",
      "class_name": "HelloWorld",
    },
    {
      "name": "example-agent",
      "binding": "EXAMPLE_AGENT",
      "class_name": "ExampleAgent",
    },
    {
      "name": "drip-email",
      "binding": "DRIP_EMAIL",
      "class_name": "DripEmail",
    },
    {
      "name": "nightly-cleanup",
      "binding": "NIGHTLY_CLEANUP",
      "class_name": "NightlyCleanup",
    },
    // 007 — runs authored workflow graphs and eval sweeps.
    {
      "name": "graph-workflow",
      "binding": "GRAPH_WORKFLOW",
      "class_name": "GraphWorkflow",
    },
    {
      "name": "eval-sweep-workflow",
      "binding": "EVAL_SWEEP_WORKFLOW",
      "class_name": "EvalSweepWorkflow",
    },
  ],

  // Durable Objects — per-run progress + WebSocket fan-out.
  //   PROGRESS_ROOM  the example workflows' room (src/durable-objects)
  //   RUN_ROOM       007's room (name fixed by the SDK's binding contract)
  //   CHAT_ROOM      the app chat: presence, typing, live messages
  "durable_objects": {
    "bindings": [
      { "name": "PROGRESS_ROOM", "class_name": "ProgressRoom" },
      { "name": "RUN_ROOM", "class_name": "RunRoom" },
      { "name": "CHAT_ROOM", "class_name": "ChatRoom" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ProgressRoom", "RunRoom"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ChatRoom"],
    },
  ],

  // D1. `migrations_dir` on WF_DB points into the 007 submodule, so
  // `bun run db:migrate:wf[:local]` from this package applies 007's schema.
  // TODO: create both databases (`bunx wrangler d1 create <name>`), paste the
  // ids, and keep them in sync with apps/web and packages/db.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "template-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
    {
      "binding": "WF_DB",
      "database_name": "template-wf",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../packages/007/migrations",
    },
  ],

  // Workers AI + Vectorize — the 007 document tools (packages/wf-host/src/tools/documents.ts).
  // Vectorize has no local simulator, so `wrangler dev` uses the real index.
  // TODO: create the index once —
  //   bunx wrangler vectorize create template-documents --dimensions=1024 --metric=cosine
  "ai": { "binding": "AI" },
  "vectorize": [
    {
      "binding": "DOCUMENTS_INDEX",
      "index_name": "template-documents",
      "remote": true,
    },
  ],

  // Uploaded documents — read by 007's `extract_text`, written by
  // `create_document`. Same bucket as apps/web (tool previews run there).
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "template-uploads" }],

  // Browser Rendering — rasterizes scanned PDFs for `extract_text`'s OCR.
  "browser": { "binding": "BROWSER", "remote": true },

  // Cloudflare Email Sending. TODO: allowed sender(s) — keep in sync with apps/web.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@example.com"],
    },
  ],

  // Queues — fire-and-forget background work with batched retries.
  "queues": {
    "producers": [
      { "queue": "template-notifications", "binding": "NOTIFICATIONS" },
    ],
    "consumers": [
      {
        "queue": "template-notifications",
        "max_batch_size": 25,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "template-notifications-dlq",
      },
    ],
  },

  // Cron triggers — fire scheduled events; the handler enqueues to the queue.
  "triggers": {
    "crons": ["0 3 * * *"],
  },

  // Vars (non-secret). Secrets via `wrangler secret put`: TOKEN_SIGNING_KEY,
  // OPENROUTER_API_KEY, WF_CONNECTOR_KEY (same value as apps/web).
  // Browser uses PUBLIC_BASE_URL to subscribe to SSE/WS endpoints directly.
  "vars": {
    "PUBLIC_BASE_URL": "http://localhost:8787",
  },

  // ── Staging: backs PR preview deploys of the web Worker ───────────────────
  // Deployed from CI on each PR (last one wins — previews share it). Workflow
  // and queue names are account-wide, hence the `-staging` suffixes.
  // Bindings below are NOT inherited from the top level, so they're repeated.
  // TODO: create the staging resources (`/setup preview`) and paste the ids.
  "env": {
    "staging": {
      "name": "template-workflows-staging",
      "workers_dev": true,
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "workflows": [
        {
          "name": "hello-world-staging",
          "binding": "HELLO_WORLD",
          "class_name": "HelloWorld",
        },
        {
          "name": "example-agent-staging",
          "binding": "EXAMPLE_AGENT",
          "class_name": "ExampleAgent",
        },
        {
          "name": "drip-email-staging",
          "binding": "DRIP_EMAIL",
          "class_name": "DripEmail",
        },
        {
          "name": "nightly-cleanup-staging",
          "binding": "NIGHTLY_CLEANUP",
          "class_name": "NightlyCleanup",
        },
        {
          "name": "graph-workflow-staging",
          "binding": "GRAPH_WORKFLOW",
          "class_name": "GraphWorkflow",
        },
        {
          "name": "eval-sweep-workflow-staging",
          "binding": "EVAL_SWEEP_WORKFLOW",
          "class_name": "EvalSweepWorkflow",
        },
      ],
      "durable_objects": {
        "bindings": [
          { "name": "PROGRESS_ROOM", "class_name": "ProgressRoom" },
          { "name": "RUN_ROOM", "class_name": "RunRoom" },
          { "name": "CHAT_ROOM", "class_name": "ChatRoom" },
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "template-db-staging",
          "database_id": "00000000-0000-0000-0000-000000000002",
        },
        {
          "binding": "WF_DB",
          "database_name": "template-wf-staging",
          "database_id": "00000000-0000-0000-0000-000000000003",
          "migrations_dir": "../../packages/007/migrations",
        },
      ],
      "ai": { "binding": "AI" },
      "vectorize": [
        {
          "binding": "DOCUMENTS_INDEX",
          "index_name": "template-documents-staging",
        },
      ],
      "r2_buckets": [
        { "binding": "UPLOADS", "bucket_name": "template-uploads-staging" },
      ],
      "browser": { "binding": "BROWSER" },
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["noreply@example.com"],
        },
      ],
      "queues": {
        "producers": [
          {
            "queue": "template-notifications-staging",
            "binding": "NOTIFICATIONS",
          },
        ],
        "consumers": [
          {
            "queue": "template-notifications-staging",
            "max_batch_size": 25,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "template-notifications-staging-dlq",
          },
        ],
      },
      // No nightly cron on staging.
      "triggers": { "crons": [] },
      "vars": {
        // TODO: https://template-workflows-staging.<subdomain>.workers.dev
        "PUBLIC_BASE_URL": "",
      },
    },
  },
}
