{
  "$schema": "node_modules/wrangler/config-schema.json",
  // OpenNext's handler (.open-next/worker.js) wrapped with Sentry — see worker.ts.
  "main": "worker.ts",
  // TODO: choose the Worker name (and keep apps/workflows' service binding in sync).
  "name": "template-web",
  "compatibility_date": "2025-08-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  // The deployed version's id — Sentry tags events with it as the release.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // TODO: custom domain — `"routes": [{ "pattern": "app.example.com", "custom_domain": true }]`.

  // Service binding to the workflows worker. Wrangler routes RPC calls
  // between the two workers in `wrangler dev`; in prod, both workers must
  // be deployed in the same Cloudflare account.
  "services": [{ "binding": "WORKFLOWS", "service": "template-workflows" }],

  // D1 — no `migrations_dir` here; this Worker never migrates. App migrations
  // run from packages/db, 007's from apps/workflows.
  // TODO: create both databases (`bunx wrangler d1 create <name>`) and paste the ids.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "template-db",
      "database_id": "b1f084e0-37fd-4631-9552-48f6877504dc",
    },
    {
      "binding": "WF_DB",
      "database_name": "template-wf",
      "database_id": "9d83a8dc-ef85-48ea-843e-9770ebb66910",
    },
  ],

  // AVATARS: user-uploaded profile pictures, served back through /api/avatar.
  // UPLOADS: documents for 007's `extract_text` / `create_document` — bound
  // here too because the console's tool and agent previews run in this Worker.
  "r2_buckets": [
    { "binding": "AVATARS", "bucket_name": "template-avatars" },
    { "binding": "UPLOADS", "bucket_name": "template-uploads" },
  ],

  // Workers AI + Browser Rendering for `extract_text` (same as apps/workflows).
  // `remote: true`: neither runs locally, so dev uses the real ones.
  "ai": { "binding": "AI", "remote": true },
  "browser": { "binding": "BROWSER", "remote": true },
  // Vectorize — the 007 document tools, for the tool/agent playgrounds. Same
  // index as apps/workflows; `remote: true` because it has no local simulator.
  "vectorize": [
    {
      "binding": "DOCUMENTS_INDEX",
      "index_name": "template-documents",
      "remote": true,
    },
  ],

  // Cloudflare Email Sending. No local simulator: in dev, sends are logged.
  // TODO: onboard the sending domain and set the allowed sender(s).
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@example.com"],
    },
  ],

  // Vars (non-secret). Secrets: `wrangler secret put BETTER_AUTH_SECRET`,
  // `GOOGLE_CLIENT_SECRET`, `TURNSTILE_SECRET_KEY`, `OPENROUTER_API_KEY`,
  // `WF_CONNECTOR_KEY`, `POSTHOG_API_KEY`, `SENTRY_DSN`.
  // TODO: fill in production values.
  "vars": {
    "APP_URL": "https://template-web.template-78f.workers.dev",
    "GOOGLE_CLIENT_ID": "",
    "TURNSTILE_SITE_KEY": "",
    "EMAIL_FROM": "",
    "EMAIL_FROM_NAME": "",
    "POSTHOG_HOST": "https://us.i.posthog.com",
  },

  // ── Staging: PR preview deploys (.github/workflows/ci.yml `preview`) ──────
  // Its own Worker, D1s and bucket so a PR never touches production data.
  // Each PR uploads a version with alias `pr-<n>`, served at
  // https://pr-<n>-template-web-staging.<subdomain>.workers.dev.
  // Bindings below are NOT inherited from the top level, so they're repeated.
  // TODO: create the staging resources (`/setup preview`) and paste the ids.
  "env": {
    "staging": {
      "name": "template-web-staging",
      "workers_dev": true,
      "preview_urls": true,
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "services": [
        { "binding": "WORKFLOWS", "service": "template-workflows-staging" },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "template-db-staging",
          "database_id": "00000000-0000-0000-0000-000000000002",
        },
        {
          "binding": "WF_DB",
          "database_name": "template-wf-staging",
          "database_id": "00000000-0000-0000-0000-000000000003",
        },
      ],
      "r2_buckets": [
        { "binding": "AVATARS", "bucket_name": "template-avatars-staging" },
        { "binding": "UPLOADS", "bucket_name": "template-uploads-staging" },
      ],
      "ai": { "binding": "AI" },
      "browser": { "binding": "BROWSER" },
      "vectorize": [
        {
          "binding": "DOCUMENTS_INDEX",
          "index_name": "template-documents-staging",
        },
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["noreply@example.com"],
        },
      ],
      // APP_URL is per-PR, so it's baked in at build time by CI instead.
      "vars": {
        "GOOGLE_CLIENT_ID": "",
        "TURNSTILE_SITE_KEY": "",
        "EMAIL_FROM": "",
        "EMAIL_FROM_NAME": "",
        "POSTHOG_HOST": "https://us.i.posthog.com",
        // robots.txt disallows everything on previews.
        "NOINDEX": "1",
      },
    },
  },
}
