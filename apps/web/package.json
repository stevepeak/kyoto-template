{
  "name": "@app/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf node_modules dist",
    "dev": "next dev --port 3000 --turbo",
    "build": "bun --env-file=../../.env next build --turbo",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start --port 3000",
    "lint": "eslint --ignore-pattern='.next' . && prettier --ignore-path='../../.prettierignore' --check .",
    "fix": "eslint --fix --quiet --ignore-pattern='.next' . && prettier --ignore-path='../../.prettierignore' --log-level=silent --write .",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@app/api": "workspace:*",
    "@app/db": "workspace:*",
    "@app/workflows-client": "workspace:*",
    "@better-auth/passkey": "^1.6.11",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/react-query": "catalog:",
    "@trpc/server": "catalog:",
    "better-auth": "^1.4.12",
    "lucide-react": "^1.16.0",
    "next": "^16.0.3",
    "posthog-js": "catalog:",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@kyoto/eslint-config": "workspace:*",
    "@opennextjs/cloudflare": "^1.5.0",
    "wrangler": "^4.92.0",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/addon-onboarding": "^10.4.0",
    "@storybook/addon-vitest": "^10.4.0",
    "@storybook/nextjs-vite": "^10.4.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "catalog:",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/browser": "4.1.6",
    "autoprefixer": "^10.4.23",
    "eslint": "^10.4.0",
    "storybook": "^10.4.0",
    "tailwindcss": "^4.1.16",
    "typescript": "catalog:",
    "vite": "^8.0.13",
    "vitest": "4.1.6"
  }
}
