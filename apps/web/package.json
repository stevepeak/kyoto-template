{
  "name": "@app/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf node_modules dist",
    "predev": "test -e .dev.vars || ln -sf ../../.env .dev.vars",
    "dev": "bun --env-file=../../.env next dev --port 3000 --turbo",
    "build": "bun --env-file=../../.env next build --turbo",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --keep-vars --upload-source-maps=false",
    "upload:preview": "opennextjs-cloudflare build && opennextjs-cloudflare upload --env staging -- --upload-source-maps=false --preview-alias \"$PREVIEW_ALIAS\" --tag \"$PREVIEW_ALIAS\"",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start --port 3000",
    "lint": "eslint --ignore-pattern='.next' . && prettier --ignore-path='../../.prettierignore' --check .",
    "fix": "eslint --fix --quiet --ignore-pattern='.next' . && prettier --ignore-path='../../.prettierignore' --log-level=silent --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:seed:local": "bun scripts/seed-demo-user.ts",
    "stripe:sync": "bun --env-file=../../.env scripts/stripe-sync-plans.ts"
  },
  "dependencies": {
    "@app/api": "workspace:*",
    "@app/db": "workspace:*",
    "@app/email": "workspace:*",
    "@app/wf-host": "workspace:*",
    "@app/workflows-client": "workspace:*",
    "@better-auth/api-key": "^1.7.25",
    "@better-auth/mcp": "^1.7.25",
    "@better-auth/passkey": "^1.7.25",
    "@better-auth/stripe": "^1.7.25",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sentry/nextjs": "^11.12.0",
    "@stevepeak/007": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/react-query": "catalog:",
    "@trpc/server": "catalog:",
    "better-auth": "^1.7.25",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "posthog-js": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonner": "^2.0.8",
    "stripe": "^23.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@app/eslint-config": "workspace:*",
    "@cloudflare/workers-types": "catalog:",
    "@opennextjs/cloudflare": "^1.20.17",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.4.0",
    "react-grab": "^0.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
