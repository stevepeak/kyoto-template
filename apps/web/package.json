{
  "name": "@app/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf node_modules dist",
    "dev": "next dev --port 3000 --turbo",
    "build": "bun --env-file=../../.env next build --turbo",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start --port 3000",
    "lint": "eslint --ignore-pattern='.next' . && prettier --ignore-path='../../.prettierignore' --check .",
    "fix": "eslint --fix --quiet --ignore-pattern='.next' . && prettier --ignore-path='../../.prettierignore' --log-level=silent --write .",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@app/api": "workspace:*",
    "@app/db": "workspace:*",
    "@app/workflows-client": "workspace:*",
    "@better-auth/passkey": "^1.7.23",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/react-query": "catalog:",
    "@trpc/server": "catalog:",
    "better-auth": "^1.7.23",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "posthog-js": "catalog:",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@kyoto/eslint-config": "workspace:*",
    "@opennextjs/cloudflare": "^1.20.17",
    "wrangler": "^4.162.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-onboarding": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/nextjs-vite": "^10.6.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser": "5.1.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.4.0",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "typescript": "catalog:",
    "vite": "^8.0.13",
    "vitest": "5.1.0"
  }
}
